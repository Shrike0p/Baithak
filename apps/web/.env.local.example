# ── Local development ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER@localhost:5432/baithak?schema=public"
# Same as DATABASE_URL locally. In production this is Supabase's DIRECT
# connection (port 5432) — migrations can't run through a transaction pooler.
DIRECT_URL="postgresql://USER@localhost:5432/baithak?schema=public"

BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Where apps/api is reachable from the server. The browser never sees this —
# /api/* is rewritten server-side, which is why there's no CORS.
API_ORIGIN="http://localhost:3001"

# Absolute origin for link previews. The OG ticket embeds the plan cover, and a
# relative path has nothing to resolve against inside the image renderer.
SITE_ORIGIN="http://localhost:3000"

# Google sign-in. Optional — the button only appears when both are set.
# Redirect URI: <origin>/auth/callback/google  (note /auth, not /api/auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Production (baithak.buzz) ────────────────────────────────────────────────
# Set these in the Vercel project, not here.
#
# DATABASE_URL       postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL         postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# BETTER_AUTH_URL    https://baithak.buzz
# API_ORIGIN         https://api.baithak.buzz
# SITE_ORIGIN        https://baithak.buzz
# BETTER_AUTH_SECRET a fresh one — never reuse the local secret
