// Minimal slice of docs/ARCHITECTURE.md's full schema — just what Discover,
// Plan Details, and Request to Join need. Add tables here only when the
// screen/flow that needs them is next (see docs/PRODUCT_PLAN.md phases).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Serverless functions each open their own connection, and Postgres runs out
  // long before the traffic does. DATABASE_URL points at Supabase's pooler
  // (port 6543, ?pgbouncer=true&connection_limit=1).
  url       = env("DATABASE_URL")
  // Migrations and introspection can't run through a transaction pooler, so
  // they use a direct connection (port 5432). Locally both are the same URL.
  directUrl = env("DIRECT_URL")
}

// Self-described and optional. Used only for the aggregate mix shown on a plan
// (a safety signal for guests) and the host's soft target — never to filter or
// auto-reject anyone. PREFER_NOT_TO_SAY and null are both excluded from counts.
enum Gender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

// Core auth fields (email .. image) are owned by Better Auth; the rest is ours
// and is written by onboarding. Gender stays a Prisma enum rather than a Better
// Auth additionalField so the database keeps enforcing the allowed values.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  age         Int?
  city        String?
  occupation  String?
  gender      Gender?
  bio         String?
  // One social account, as a trust signal — a host deciding on a stranger
  // wants to see the person exists elsewhere. LinkedIn carries the most
  // weight; Instagram is the common fallback. Stored as a full URL and
  // validated against an allowlist of hosts in apps/api.
  socialUrl   String?
  vibeTags    String[] @default([])
  trustScore  Float     @default(0)
  onboardedAt DateTime?

  sessions     Session[]
  accounts     Account[]
  hostedPlans  Plan[]
  attendances  PlanAttendee[]
  applications Application[]
  photos       Photo[]
  blocksMade   Block[]   @relation("blocker")
  blocksGot    Block[]   @relation("blocked")
  reportsMade  Report[]  @relation("reporter")
  reportsGot   Report[]  @relation("reported")
  notifications Notification[]
  reviewsWritten Review[]       @relation("reviewsWritten")
  hangoutPicks   HangoutAgain[] @relation("hangoutPicks")
  connectionsA   Connection[]   @relation("connectionsA")
  connectionsB   Connection[]   @relation("connectionsB")
  messages       Message[]
}

// Sessions live here rather than in a stateless token so apps/api can validate
// against the same database, and revoking one takes effect immediately.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per sign-in method. Password hashes live here, never on User.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum PlanCategory {
  HOUSE_PARTY
  DRINKS
  DINNER
  GAME_NIGHT
  MOVIE
  SPORTS
  TRIP
  OTHER
}

enum PlanStatus {
  DRAFT
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

model Plan {
  id            String       @id @default(cuid())
  hostId        String
  host          User         @relation(fields: [hostId], references: [id])
  title         String
  category      PlanCategory
  vibeTags      String[]
  neighborhood  String
  exactAddress  String? // never returned publicly — see ARCHITECTURE.md flow 2.4
  imageUrl      String? // preset cover for now; host uploads once blob storage exists
  startsAt      DateTime
  capacity      Int
  status        PlanStatus   @default(OPEN)
  createdAt     DateTime     @default(now())

  // Profile steps this host insists on before someone may even apply — step
  // keys from @baithak/types (social, occupation, bio). Empty means the
  // platform baseline only. Stored per plan, not per host: the bar for a
  // twelve-person house party is not the bar for a board-game night.
  requiredOfGuests String[] @default([])

  // Screening questions from @baithak/types' catalogue, by id, in the order the
  // host chose. Ids rather than embedded copies: the wording is ours to fix,
  // and a typo shouldn't be frozen into every plan that ever asked it.
  rsvpQuestions String[] @default([])

  // Shown before the RSVP, with a checkbox the guest has to tick. Null means
  // this host hasn't written any and the checkbox is skipped entirely.
  houseRules String?

  // What each guest chips in, in whole rupees. Null = free. Display only:
  // guests pay the host directly, Baithak never touches the money (yet).
  chipIn     Int?
  // What the chip-in covers — "food, snacks & the space".
  chipInNote String?
  // Where guests send the chip-in. Only ever leaves the API inside the party
  // room — same gate as the exact address.
  upiId      String?
  // Host wants a number from everyone who asks. It's stored on the
  // application and shown to the host only once that person is accepted.
  askPhone   Boolean @default(false)

  attendees    PlanAttendee[]
  applications Application[]
  crowd        CrowdPreference?
  photos       Photo[]
  reports      Report[]
  reviews      Review[]
  messages     Message[]
}

// Post-party memories. Uploader is kept so a photo can be attributed/removed.
//
// Visibility is attendee-only by default — guests shared these of a private
// house party, not of the internet. isPublic is the host's opt-in for their own
// uploads, used for the teaser on a wrapped-up party (see
// docs/superpowers/specs/2026-09-18-party-lifecycle-design.md).
model Photo {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  url        String
  caption    String?
  takenAt    DateTime?
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/**
 * One person choosing not to see another. Enforced on read — a blocked
 * person's plans and profile disappear from the blocker's view, and neither
 * can apply to the other's plans.
 *
 * Deliberately one-directional and silent: the blocked person is never told,
 * because telling them is how blocking turns into a confrontation.
 */
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

/**
 * A report of a person or a plan. There is no moderation queue yet — these are
 * written so the record exists from day one, because the alternative is asking
 * people to report things into a void and losing the evidence.
 */
model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    User?        @relation("reported", fields: [subjectId], references: [id])
  planId     String?
  plan       Plan?        @relation(fields: [planId], references: [id], onDelete: Cascade)
  reason     ReportReason
  detail     String?
  createdAt  DateTime     @default(now())

  @@index([subjectId])
}

/**
 * Things that happened to you while you weren't looking.
 *
 * Written at the moment the thing happens rather than derived on read — a
 * derived feed can't record that a plan was cancelled, because the evidence is
 * exactly what gets mutated.
 *
 * `planId` and `actorId` are soft links: a notification survives the plan or
 * person going away, because the text is already baked in.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  planId    String?
  actorId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

enum NotificationKind {
  APPLICATION_ACCEPTED
  APPLICATION_DECLINED
  NEW_APPLICANT
  PLAN_CANCELLED
  PLAN_WRAPPED
  NEW_PHOTOS
  GUEST_REMOVED
  PAYMENT_CLAIMED
}

/**
 * What someone thought of a night, filed after it wrapped.
 *
 * Ratings are the raw material for `User.trustScore`, which until now was a
 * seeded number nothing ever recomputed — every star in the product was
 * fiction. One review per person per plan.
 *
 * `privateNote` is never shown to anyone but us: a guest has to be able to say
 * "the host was creepy" without it appearing under their name. Product plan
 * §21.
 */
model Review {
  id             String       @id @default(cuid())
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User         @relation("reviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  hostRating     Int
  crowdRating    Int
  vibeRating     Int
  safetyRating   Int
  attendAgain    AttendAgain
  privateNote    String?
  hangoutAgain   HangoutAgain[]
  createdAt      DateTime     @default(now())

  @@unique([planId, reviewerId])
  @@index([planId])
}

enum AttendAgain {
  YES
  MAYBE
  NO
}

/**
 * "I'd hang out with them again." Kept private until it's mutual — telling
 * someone they were picked when they didn't pick back is a small cruelty, and
 * the whole point is that a connection is agreed by both people.
 */
model HangoutAgain {
  id           String @id @default(cuid())
  reviewId     String
  review       Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User   @relation("hangoutPicks", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([reviewId, targetUserId])
  @@index([targetUserId])
}

/**
 * A mutual "hang out again". This is what finally makes "2 mutual connections"
 * a real thing rather than something derived from having been in the same room.
 *
 * Stored with the ids sorted so a pair can only exist once, in one direction.
 */
model Connection {
  id        String           @id @default(cuid())
  userAId   String
  userA     User             @relation("connectionsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User             @relation("connectionsB", fields: [userBId], references: [id], onDelete: Cascade)
  source    ConnectionSource @default(MUTUAL_HANGOUT_AGAIN)
  createdAt DateTime         @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

enum ConnectionSource {
  MUTUAL_HANGOUT_AGAIN
  SAME_PLAN
  MANUAL
}

/**
 * Party Room chat. Group only — there are no DMs, on purpose: you earn access
 * to a conversation by being accepted into the plan, which means nobody can be
 * cold-messaged by a stranger.
 *
 * Delivered by polling the table, not WebSockets (which Vercel Functions can't
 * hold open) and not LiveKit (which bills per connection-minute, a media price
 * for moving a sentence). Supabase Realtime subscribes to these same rows when
 * rooms get busy enough to notice the delay.
 */
model Message {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

enum ReportReason {
  HARASSMENT
  FAKE_PROFILE
  UNSAFE_BEHAVIOUR
  SPAM
  SOMETHING_ELSE
}

enum ConnectionPreference {
  FRIENDS_OF_FRIENDS
  COMMUNITY
  OPEN
  INVITE_ONLY
}

// The host's preferred crowd. These are targets that drive the "group health"
// nudge only — nothing here filters applicants or blocks a request.
model CrowdPreference {
  planId               String               @id
  plan                 Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  ageMin               Int?
  ageMax               Int?
  preferredVibes       String[]
  targetWomen          Int?
  targetMen            Int?
  targetCouples        Int?
  connectionPreference ConnectionPreference @default(OPEN)
}

enum AttendeeRole {
  HOST
  GUEST
}

enum AttendeeStatus {
  CONFIRMED
  CANCELLED
}

model PlanAttendee {
  id        String         @id @default(cuid())
  planId    String
  // Cascades: deleting a plan is only permitted while nobody but the host is
  // on it, and the host's own row shouldn't block that.
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  role      AttendeeRole
  status    AttendeeStatus @default(CONFIRMED)
  firstTime Boolean        @default(true)
  joinedAt  DateTime       @default(now())

  @@unique([planId, userId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  PASSED
  REVIEW_LATER
}

enum BringingWith {
  SOLO
  ONE_FRIEND
  GROUP
}

model Application {
  id           String            @id @default(cuid())
  planId       String
  plan         Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User              @relation(fields: [applicantId], references: [id])
  status       ApplicationStatus @default(PENDING)
  bringingWith BringingWith
  note         String?
  matchScore   Float?
  matchReasons String[]

  // Answers to the host's screening questions, keyed by question id. Json
  // because the shape belongs to the catalogue, not the database — a table of
  // answer rows would buy nothing here and cost a join on every desk render.
  answers Json @default("{}")
  // When they ticked the house rules. Null means this plan had none to tick.
  agreedAt DateTime?
  // Given for this plan only, when the host asked. Normalised to +<country><number>.
  phone    String?
  // The chip-in, tracked by both sides since Baithak never sees the money:
  // the guest says they sent it, the host confirms it arrived.
  paidClaimedAt   DateTime?
  paidConfirmedAt DateTime?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@unique([planId, applicantId])
}
